# ============================================================
# Copie para .env e preencha. O .env NUNCA vai para o git.
# Qualquer provider sem chave cai automaticamente no stub
# offline, entao a pipeline roda mesmo sem credencial nenhuma.
# ============================================================

# ---- Roteiro / ideacao (LLM) ----
# Providers: anthropic | openai | stub
MAQ_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
MAQ_LLM_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=

# ---- Narracao (TTS) ----
# Providers: fish | elevenlabs | openai | stub
# fish = onde a voz clonada do operador ja existe.
# ATENCAO: a chave anterior do Fish vazou em chat — revogue e gere outra.
MAQ_TTS_PROVIDER=fish
FISH_AUDIO_API_KEY=
# Para o fish, MAQ_TTS_VOICE_ID e o id do modelo de voz:
# o trecho final da URL fish.audio/m/<id>
MAQ_TTS_VOICE_ID=0f8b54a7ec2f4d328a146db341ab63ad
ELEVENLABS_API_KEY=
MAQ_TTS_MODEL=eleven_multilingual_v2

# ---- Imagens / b-roll ----
# Providers: openai | stub
MAQ_IMAGE_PROVIDER=openai
MAQ_IMAGE_MODEL=gpt-image-1

# ---- YouTube Data API v3 ----
# 1) Google Cloud Console > APIs > ative "YouTube Data API v3"
# 2) Credenciais > OAuth client ID > tipo "Desktop app" > baixe o JSON
# 3) Aponte MAQ_YT_CLIENT_SECRET para esse arquivo e rode: maquina auth-youtube
MAQ_YT_CLIENT_SECRET=secrets/client_secret.json
MAQ_YT_TOKEN=secrets/youtube_token.json

# ---- Diretorios ----
MAQ_DATA_DIR=data
MAQ_OUT_DIR=out
